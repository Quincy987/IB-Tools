<ui:RevitWindow x:Class="FoundationProjectionToggle.UI.RemmingwerkWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:FoundationProjectionToggle.UI"
                Title="Remmingwerk"
                MinWidth="560"
                ResizeMode="NoResize">
    <StackPanel Margin="14">
        <TextBlock x:Name="InfoText"
                   TextWrapping="Wrap"
                   MaxWidth="560"
                   HorizontalAlignment="Left"
                   Foreground="#444444"
                   Margin="0,0,0,10" />

        <GroupBox Header="Plaats" Padding="6" Margin="0,0,0,8">
            <StackPanel>
                <RadioButton x:Name="SideRight" GroupName="Side" Margin="0,0,0,4" Checked="OnChanged"
                             Content="Palen rechts van de tekenrichting (zoals Dynamo)" />
                <RadioButton x:Name="SideLeft" GroupName="Side" Margin="0,0,0,6" Checked="OnChanged"
                             Content="Palen links van de tekenrichting" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="NAP-level" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" x:Name="LevelBox" SelectionChanged="OnChanged" />
                </Grid>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Typen" Padding="6" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Wrijfgording" VerticalAlignment="Center" Margin="0,0,0,4" />
                <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="WrijfgordingBox" Margin="0,0,0,4" SelectionChanged="OnChanged" />
                <TextBlock Grid.Row="1" Text="Wrijfstijl" VerticalAlignment="Center" Margin="0,0,0,4" />
                <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="WrijfstijlBox" Margin="0,0,0,4" SelectionChanged="OnChanged" />
                <TextBlock Grid.Row="2" Text="Stalen gording" VerticalAlignment="Center" Margin="0,0,0,4" />
                <ComboBox  Grid.Row="2" Grid.Column="1" x:Name="GordingBox" Margin="0,0,0,4" SelectionChanged="OnChanged" />
                <TextBlock Grid.Row="3" Text="Stalen stijl" VerticalAlignment="Center" Margin="0,0,0,4" />
                <ComboBox  Grid.Row="3" Grid.Column="1" x:Name="StijlBox" Margin="0,0,0,4" SelectionChanged="OnChanged" />
                <TextBlock Grid.Row="4" Text="Buispaal" VerticalAlignment="Center" />
                <ComboBox  Grid.Row="4" Grid.Column="1" x:Name="PaalBox" SelectionChanged="OnChanged" />
            </Grid>
        </GroupBox>

        <GroupBox Header="Maten (mm)" Padding="6" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Aantal gordingrijen" VerticalAlignment="Center" Margin="0,0,0,4" />
                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="RowsBox" Margin="0,0,0,4" Padding="2" TextChanged="OnChanged" />
                <TextBlock Grid.Row="0" Grid.Column="3" Text="h.o.h. gordingen" VerticalAlignment="Center" Margin="0,0,0,4" />
                <TextBox   Grid.Row="0" Grid.Column="4" x:Name="RowSpacingBox" Margin="0,0,0,4" Padding="2" TextChanged="OnChanged" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Breedte wrijfgording" VerticalAlignment="Center" Margin="0,0,0,4" />
                <TextBox   Grid.Row="1" Grid.Column="1" x:Name="WrijfBreedteBox" Margin="0,0,0,4" Padding="2" TextChanged="OnChanged" />
                <TextBlock Grid.Row="1" Grid.Column="3" Text="Hoogte wrijfgording" VerticalAlignment="Center" Margin="0,0,0,4" />
                <TextBox   Grid.Row="1" Grid.Column="4" x:Name="WrijfHoogteBox" Margin="0,0,0,4" Padding="2" TextChanged="OnChanged" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="h.o.h. buispalen" VerticalAlignment="Center" Margin="0,0,0,4" />
                <TextBox   Grid.Row="2" Grid.Column="1" x:Name="PileSpacingBox" Margin="0,0,0,4" Padding="2" TextChanged="OnChanged" />
                <TextBlock Grid.Row="2" Grid.Column="3" Text="O.k. buispaal t.o.v. NAP" VerticalAlignment="Center" Margin="0,0,0,4" />
                <TextBox   Grid.Row="2" Grid.Column="4" x:Name="PileTipBox" Margin="0,0,0,4" Padding="2" TextChanged="OnChanged" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Overlengte paal boven gording" VerticalAlignment="Center" />
                <TextBox   Grid.Row="3" Grid.Column="1" x:Name="OverlengthBox" Padding="2" TextChanged="OnChanged" />
            </Grid>
        </GroupBox>

        <TextBlock x:Name="OverviewText"
                   TextWrapping="Wrap"
                   MaxWidth="560"
                   HorizontalAlignment="Left"
                   Foreground="#2E7D32"
                   Margin="0,2,0,0" />

        <TextBlock x:Name="ErrorText"
                   TextWrapping="Wrap"
                   MaxWidth="560"
                   HorizontalAlignment="Left"
                   Foreground="#C62828"
                   FontWeight="SemiBold"
                   Margin="0,6,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton"
                    Content="Plaatsen"
                    Padding="12,4" Margin="0,0,8,0" MinWidth="80"
                    IsDefault="True"
                    Click="OnOkClick" />
            <Button x:Name="CancelButton"
                    Content="Annuleren"
                    Padding="12,4" MinWidth="80"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</ui:RevitWindow>
