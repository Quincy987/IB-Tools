<ui:RevitWindow x:Class="FoundationProjectionToggle.UI.CoordinateInputWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:FoundationProjectionToggle.UI"
                Title="Modelpunt op coördinaat"
                MinWidth="420"
                ResizeMode="NoResize">
    <StackPanel Margin="14">
        <TextBlock x:Name="InfoText"
                   TextWrapping="Wrap"
                   MaxWidth="420"
                   HorizontalAlignment="Left"
                   Foreground="#444444"
                   Margin="0,0,0,10" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="RD X (oost)" VerticalAlignment="Center" Margin="0,0,10,6" />
            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="XBox" Margin="0,0,0,6" Padding="2" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="m" VerticalAlignment="Center" Margin="6,0,0,6" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="RD Y (noord)" VerticalAlignment="Center" Margin="0,0,10,6" />
            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="YBox" Margin="0,0,0,6" Padding="2" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="m" VerticalAlignment="Center" Margin="6,0,0,6" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Hoogte" VerticalAlignment="Center" Margin="0,0,10,6" />
            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="ZBox" Margin="0,0,0,6" Padding="2" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="m NAP" VerticalAlignment="Center" Margin="6,0,0,6" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Schaal (type)" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox  Grid.Row="3" Grid.Column="1" x:Name="TypeBox" />
        </Grid>

        <TextBlock x:Name="SourceText"
                   TextWrapping="Wrap"
                   MaxWidth="420"
                   HorizontalAlignment="Left"
                   Foreground="#2E7D32"
                   Margin="0,10,0,0" />

        <TextBlock x:Name="ErrorText"
                   TextWrapping="Wrap"
                   MaxWidth="420"
                   HorizontalAlignment="Left"
                   Foreground="#C62828"
                   FontWeight="SemiBold"
                   Margin="0,6,0,0" />

        <Grid Margin="0,14,0,0">
            <Button x:Name="PasteButton"
                    HorizontalAlignment="Left"
                    Content="Plakken (x y z)"
                    Padding="10,4"
                    ToolTip="Leest &quot;x y [z]&quot; van het klembord (m of mm)."
                    Click="OnPasteClick" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton"
                        Content="Plaatsen"
                        Padding="12,4" Margin="0,0,8,0" MinWidth="80"
                        IsDefault="True"
                        Click="OnOkClick" />
                <Button Content="Annuleren"
                        Padding="12,4" MinWidth="80"
                        IsCancel="True" />
            </StackPanel>
        </Grid>
    </StackPanel>
</ui:RevitWindow>
