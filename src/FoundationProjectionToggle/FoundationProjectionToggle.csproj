<Project Sdk="Microsoft.NET.Sdk">

  <!--
    IB TOOLS (assembly name still FoundationProjectionToggle, see README "Hernoemen")
    ================================================================================
    One project, one RevitVersion per build:

      dotnet build -c Release -p:RevitVersion=2023   (default)  -> net48
      dotnet build -c Release -p:RevitVersion=2024              -> net48
      dotnet build -c Release -p:RevitVersion=2025              -> net8.0-windows

    A plain `dotnet build` only compiles. Deploying to the Revit Addins folder is done by
    build.ps1 (which respects other Revit sessions on this machine), or opt-in here with
    -p:Deploy=true.

    Conditional compilation: REVIT2022 / REVIT2023 / REVIT2024 / REVIT2025 are defined per
    build, plus REVIT2025_OR_GREATER for the .NET 8 line.
  -->

  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)'==''">2023</RevitVersion>

    <!-- Revit 2022-2024 run on .NET Framework 4.8, Revit 2025+ on .NET 8. -->
    <TargetFramework Condition="'$(RevitVersion)'&lt;'2025'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)'&gt;='2025'">net8.0-windows</TargetFramework>

    <!-- WPF (XAML windows) for both frameworks. -->
    <UseWPF>true</UseWPF>

    <!-- Revit is 64-bit only -->
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>

    <AssemblyName>FoundationProjectionToggle</AssemblyName>
    <RootNamespace>FoundationProjectionToggle</RootNamespace>
    <Version>1.1.0</Version>
    <Product>IB Tools</Product>
    <AssemblyTitle>IB Tools for Revit</AssemblyTitle>
    <Authors>Ingenieursbureau Gemeente Amsterdam</Authors>
    <Company>Ingenieursbureau Gemeente Amsterdam</Company>
    <Copyright>Ingenieursbureau Gemeente Amsterdam</Copyright>
    <Description>IB Tools: Revit-knoppen van het Ingenieursbureau Amsterdam</Description>

    <OutputPath>bin\$(Configuration)\Revit$(RevitVersion)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- .NET 8: Revit provides its own runtime; no deps.json/runtimeconfig needed next to the dll. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <EnableDynamicLoading Condition="'$(TargetFramework)'=='net8.0-windows'">true</EnableDynamicLoading>

    <!-- The Revit SDK package ships native DLLs (RevitDB, RevitMFC...) in ref/: harmless "bad image" warnings. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3246</MSBuildWarningsAsMessages>

    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)'&gt;='2025'">$(DefineConstants);REVIT2025_OR_GREATER</DefineConstants>

    <RevitAddinFolder>$(APPDATA)\Autodesk\Revit\Addins\$(RevitVersion)</RevitAddinFolder>
  </PropertyGroup>

  <!--
    REVIT SDK REFERENCES (compile-time only; Revit provides the real assemblies at runtime).
  -->
  <ItemGroup>
    <PackageReference Include="Autodesk.Revit.SDK" Version="$(RevitVersion).*">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    EMBEDDED RESOURCES
    Icons: {RootNamespace}.UI.Resources.icons.{name}-32.png / -16.png
    (load with IconLoader.Load("name-32.png") or via RibbonManager.AddPushButton iconName "name").
  -->
  <ItemGroup>
    <EmbeddedResource Include="UI\Resources\icons\*.png" />
    <!-- Coordinate point family (Modelpunt op coördinaat), loaded from here, never from the network. -->
    <EmbeddedResource Include="Resources\families\IB_GM_coordinaatpunt.rfa" LogicalName="FoundationProjectionToggle.Resources.families.IB_GM_coordinaatpunt.rfa" />
    <!-- Remmingwerk: timber wrijfgording (Structural Framing) and wrijfstijl (Generic Model), copies of
         K:\ALG\Autodesk\2023\REVIT\Revit bibliotheek\Kademuren\ (2023-04-28). -->
    <EmbeddedResource Include="Resources\families\SB_wrijfgording.rfa" LogicalName="FoundationProjectionToggle.Resources.families.SB_wrijfgording.rfa" />
    <EmbeddedResource Include="Resources\families\SC_wrijfstijl_generic model.rfa" LogicalName="FoundationProjectionToggle.Resources.families.SC_wrijfstijl_generic model.rfa" />
  </ItemGroup>

  <!--
    OPT-IN DEPLOYMENT (-p:Deploy=true). build.ps1 does its own, lock-aware deployment and
    does not use this target.
  -->
  <Target Name="DeployAddin" AfterTargets="Build" Condition="'$(Deploy)'=='true'">
    <Message Importance="high" Text="Deploying to Revit $(RevitVersion) Addins folder..." />
    <MakeDir Directories="$(RevitAddinFolder)" Condition="!Exists('$(RevitAddinFolder)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(RevitAddinFolder)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)..\..\FoundationProjectionToggle.addin" DestinationFolder="$(RevitAddinFolder)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployment complete: $(RevitAddinFolder)" />
  </Target>

</Project>
