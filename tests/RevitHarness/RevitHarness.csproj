<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Revit integration test harness for IB Tools (NOT part of the add-in, never shipped).
    Loaded into a test Revit 2023 by scripts in this folder; it only does something when the
    environment variable IBTOOLS_HARNESS_JOB points to a job folder (so other Revit sessions
    that happen to load it stay untouched). See README.md here.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <AssemblyName>IBTools.RevitHarness</AssemblyName>
    <RootNamespace>IBTools.RevitHarness</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3246</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Autodesk.Revit.SDK" Version="2023.*">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FoundationProjectionToggle\FoundationProjectionToggle.csproj">
      <Private>false</Private>
      <SetConfiguration>Configuration=Release</SetConfiguration>
    </ProjectReference>
  </ItemGroup>

</Project>
